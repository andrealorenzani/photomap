{
  "name": "photomap/backend",
  "description": "Photomap Phase 2 accounts backend (PHP + MySQL)",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.1",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-gd": "*",
    "ext-fileinfo": "*",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-exif": "*",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^10"
  },
  "autoload": {
    "psr-4": {
      "Photomap\\Backend\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Photomap\\Backend\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "migrate": "php scripts/migrate.php"
  },
  "config": {
    "sort-packages": true
  }
}

# Copy this file to .env and fill in real values.

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=photomap
DB_USER=photomap
DB_PASSWORD=changeme

# App
# APP_ENV=production gates the session cookie's Secure flag (must be true in production,
# since browsers only honor Secure over HTTPS). Use APP_ENV=local only for plain-HTTP dev
# via `php -S`.
APP_ENV=local
# Generate with: php -r 'echo bin2hex(random_bytes(32));'
APP_SECRET=change_me_to_a_random_32_byte_hex_string

# Storage (absolute path, outside the web root / public/ directory)
STORAGE_PATH=/absolute/path/to/backend/storage

# Uploads
MAX_UPLOAD_BYTES=26214400
# Per-account storage quota is no longer a single flat env-var constant — it's now
# admin-configurable at runtime (default quota for new users + a global upload kill-switch)
# via the /admin console's Settings panel, backed by the `app_settings` table. The
# migration seeds a 100MB default; change it from the admin UI, not here.

# Nominatim (must include real contact info per Nominatim's usage policy)
NOMINATIM_USER_AGENT="Photomap/1.0 (contact: you@example.com)"

# Session
SESSION_COOKIE_NAME=photomap_session

# Login rate limiting
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900

# Registration rate limiting / anti-spam. Separate from the login throttle above -- every
# POST /api/register counts against this window, not just failures against an existing
# account. REGISTRATION_MIN_FORM_SECONDS is a minimum elapsed time (seconds) between the
# registration form rendering client-side and the submission reaching the server, used as a
# simple bot-timing check; set to 0 to disable it entirely.
RATE_LIMIT_REGISTRATION_MAX_ATTEMPTS=5
RATE_LIMIT_REGISTRATION_WINDOW_SECONDS=3600
REGISTRATION_MIN_FORM_SECONDS=2

# Global Nominatim spacing (seconds between requests). Keep at 1 in production;
# tests override this to something tiny via a dedicated test .env.
NOMINATIM_MIN_INTERVAL_SECONDS=1

# CORS (only needed for a genuinely split-origin deployment: static frontend host on a
# different origin than this API). Same-origin deployments (the Vite dev proxy, the Docker
# nginx proxy) never need to set either of these — leave both blank/default.
#
# Comma-separated exact-match allow-list of frontend origins, e.g.
# https://photos.example.com,https://app.example.com. Empty (default) = no CORS headers
# emitted at all, and cross-origin browser requests will be blocked.
CORS_ALLOWED_ORIGINS=
# Must be "None" for a split-origin deployment (cross-site fetch() calls don't send
# SameSite=Lax cookies at all) — SameSite=None additionally requires Secure, which in turn
# requires APP_ENV=production (i.e. real HTTPS). Leave at the default "Lax" for same-origin
# deployments.
SESSION_COOKIE_SAMESITE=Lax

# --- Admin console (/admin) ---
# A single hardcoded admin username/password pair for v1.0.0 (no multi-admin support this
# release). Pick a unique username (not "admin"). Generate the password hash with:
#   php -r 'echo password_hash("your-chosen-password", PASSWORD_DEFAULT), PHP_EOL;'
# then paste the printed $2y$... string below and discard the plaintext password — it cannot
# be recovered from the hash. Leaving these two unset does NOT break the rest of the app:
# every /api/admin/* route cleanly returns 503 admin_not_configured instead, and every other
# route (registration, login, uploads, sharing) is entirely unaffected.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# Where "new registration" notification emails are sent. If unset, that notification silently
# degrades to a logged no-op — registration itself is never blocked by a missing/incomplete
# mail configuration.
ADMIN_NOTIFY_EMAIL=

# --- Mail (activation/deactivation/new-registration notifications) ---
# Sent via PHP's built-in mail(), not an SMTP library (see docs/plans.md for the rationale) —
# best-effort only, failures are logged via error_log() and never block the triggering action.
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=Photomap

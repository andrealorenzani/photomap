# Copy to .env for local dev if you want to override any of these (Vite loads .env
# automatically). None of this is required to run `npm run dev` against the default local
# backend at http://localhost:8000 — every value below has a working default.
#
# For a genuinely deployed static build, prefer editing public/config.js after `npm run build`
# instead (see README.md) — that's a plain static file, no rebuild required, and is what makes
# "same build, different backend" possible. These VITE_* values are only the build-time
# defaults layered underneath it.

# Backend API base URL used at build time (public/config.js's runtime apiBaseUrl takes priority
# over this when present). Not used by `npm run dev` at all, which instead proxies /api to
# VITE_DEV_API_PROXY_TARGET below.
VITE_API_BASE_URL=/api

# Native dev path only: where `npm run dev`'s Vite proxy forwards /api requests.
VITE_DEV_API_PROXY_TARGET=http://localhost:8000

# Map basemap styles (Detailed / Treasure Map). Both default to the same OpenStreetMap tile
# source — leave unset unless you want to point at a different tile provider or retune the
# Treasure Map look. See README.md's settings table for what each one does.
# VITE_MAP_TILE_URL_DETAILED=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION_DETAILED=&copy; OpenStreetMap contributors
# VITE_MAP_MAX_ZOOM_DETAILED=19
# VITE_MAP_TILE_URL_TREASURE=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION_TREASURE=&copy; OpenStreetMap contributors
# VITE_MAP_MAX_ZOOM_TREASURE=10
# VITE_MAP_TREASURE_CSS_FILTER=sepia(0.65) saturate(1.6) hue-rotate(-8deg) contrast(1.1)
